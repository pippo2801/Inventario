# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web App client configuration for project "inventario-studio".
# Obtain these values from Firebase Console > Project settings > Your apps > Web app.
# These are client identifiers, NOT Admin SDK credentials. Never add service-account JSON here.
# Keep the real .env file out of Git; only commit this example file.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="inventario-studio.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="inventario-studio"
VITE_FIREBASE_STORAGE_BUCKET="inventario-studio.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="948603878645"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
