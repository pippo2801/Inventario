rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function requesterExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function requesterData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function requesterOrgId() {
      return requesterData().organizationId;
    }

    function isAdmin() {
      return requesterExists() && requesterData().role == 'Amministratore';
    }

    function isOperatorOrAdmin() {
      return requesterExists() &&
        requesterData().role in ['Amministratore', 'Operatore'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validRole(role) {
      return role in ['Amministratore', 'Operatore', 'Cliente'];
    }

    function sameOrgResource() {
      return requesterExists() &&
        resource.data.organizationId == requesterOrgId();
    }

    function sameOrgRequest() {
      return requesterExists() &&
        request.resource.data.organizationId == requesterOrgId();
    }

    // User documents: self-service cannot change role or organization.
    // Admin permissions are strictly limited to their own organization.
    match /users/{userId} {
      allow read: if isOwner(userId) ||
        (isAdmin() && resource.data.organizationId == requesterOrgId());

      allow create: if isAdmin() &&
        sameOrgRequest() &&
        validRole(request.resource.data.role);

      allow update: if (
          isOwner(userId) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.organizationId == resource.data.organizationId
        ) || (
          isAdmin() &&
          !isOwner(userId) &&
          resource.data.organizationId == requesterOrgId() &&
          request.resource.data.organizationId == resource.data.organizationId &&
          validRole(request.resource.data.role)
        );

      allow delete: if isAdmin() &&
        !isOwner(userId) &&
        resource.data.organizationId == requesterOrgId();
    }

    match /organizations/{orgId} {
      allow read: if isAdmin() && orgId == requesterOrgId();
      allow create: if isAdmin() && orgId == requesterOrgId() &&
        request.resource.data.organizationId == orgId;
      allow update: if isAdmin() && orgId == requesterOrgId() &&
        resource.data.organizationId == orgId &&
        request.resource.data.organizationId == orgId;
      allow delete: if isAdmin() && orgId == requesterOrgId() &&
        resource.data.organizationId == orgId;
    }

    match /eyeglasses/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      allow create: if isOperatorOrAdmin() && sameOrgRequest();
      allow update: if isOperatorOrAdmin() && sameOrgResource() &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAdmin() && sameOrgResource();
    }

    match /clients/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      allow create: if isOperatorOrAdmin() && sameOrgRequest();
      allow update: if isOperatorOrAdmin() && sameOrgResource() &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAdmin() && sameOrgResource();
    }

    match /prescriptions/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      allow create: if isOperatorOrAdmin() && sameOrgRequest();
      allow update: if isOperatorOrAdmin() && sameOrgResource() &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAdmin() && sameOrgResource();
    }

    match /sales/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      allow create: if isOperatorOrAdmin() && sameOrgRequest();
      allow update: if isAdmin() && sameOrgResource() &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAdmin() && sameOrgResource();
    }

    match /auditLogs/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      // Only a trusted backend (for example, a Cloud Function) may write audit logs.
      allow create, update, delete: if false;
    }

    match /customCategories/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      allow create: if isOperatorOrAdmin() && sameOrgRequest();
      allow update: if isOperatorOrAdmin() && sameOrgResource() &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isOperatorOrAdmin() && sameOrgResource();
    }

    match /settings/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      allow create: if isAdmin() && sameOrgRequest();
      allow update: if isAdmin() && sameOrgResource() &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAdmin() && sameOrgResource();
    }

    match /syncStatus/{documentId} {
      allow read: if isOperatorOrAdmin() && sameOrgResource();
      allow create: if isOperatorOrAdmin() && sameOrgRequest();
      allow update: if isOperatorOrAdmin() && sameOrgResource() &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if false;
    }

    // Deny every collection not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}