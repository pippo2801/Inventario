rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function getRequesterData() {
      return getUserData(request.auth.uid);
    }
    
    function isAdmin() {
      return isSignedIn() && getRequesterData().role == 'Amministratore';
    }
    
    function isOperator() {
      return isSignedIn() && getRequesterData().role == 'Operatore';
    }
    
    function isOperatorOrAdmin() {
      return isSignedIn() && 
        (getRequesterData().role == 'Amministratore' || getRequesterData().role == 'Operatore');
    }
    
    function getRequesterOrgId() {
      return getRequesterData().organizationId;
    }
    
    function userBelongsToOrg(userId, orgId) {
      return getUserData(userId).organizationId == orgId;
    }
    
    function requesterBelongsToOrg(orgId) {
      return getRequesterOrgId() == orgId;
    }
    
    function isSelfPromotionAttempt(userId, newRole) {
      return isSignedIn() && request.auth.uid == userId && 
        newRole != resource.data.role &&
        newRole == 'Amministratore';
    }

    // Users collection - users can read their own data, admins can read all
    // Users CANNOT modify their own role; only admins can change roles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin(); // Only admins can create users
      allow update: if (isOwner(userId) || isAdmin()) && 
        (!request.resource.data.keys().hasAny(['role']) || 
         request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Organizations - only admins of that org can read/write
    match /organizations/{orgId} {
      allow read: if isAdmin() && requesterBelongsToOrg(orgId);
      allow write: if isAdmin() && requesterBelongsToOrg(orgId);
    }

    // Eyeglasses - operators and admins can read/write within their org
    match /eyeglasses/{eyeglassId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow create: if isOperatorOrAdmin() && request.resource.data.organizationId == getRequesterOrgId();
      allow update: if isOperatorOrAdmin() && 
        resource.data.organizationId == getRequesterOrgId() &&
        request.resource.data.organizationId == getRequesterOrgId();
      allow delete: if isAdmin() && resource.data.organizationId == getRequesterOrgId();
    }

    // Clients - operators and admins can read/write within their org
    match /clients/{clientId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow create: if isOperatorOrAdmin() && request.resource.data.organizationId == getRequesterOrgId();
      allow update: if isOperatorOrAdmin() && 
        resource.data.organizationId == getRequesterOrgId() &&
        request.resource.data.organizationId == getRequesterOrgId();
      allow delete: if isAdmin() && resource.data.organizationId == getRequesterOrgId();
    }

    // Prescriptions - operators and admins can read/write within their org
    match /prescriptions/{prescriptionId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow create: if isOperatorOrAdmin() && request.resource.data.organizationId == getRequesterOrgId();
      allow update: if isOperatorOrAdmin() && 
        resource.data.organizationId == getRequesterOrgId() &&
        request.resource.data.organizationId == getRequesterOrgId();
      allow delete: if isAdmin() && resource.data.organizationId == getRequesterOrgId();
    }

    // Sales - operators can create, admins can read/update/delete within their org
    match /sales/{saleId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow create: if isOperatorOrAdmin() && request.resource.data.organizationId == getRequesterOrgId();
      allow update: if isAdmin() && resource.data.organizationId == getRequesterOrgId();
      allow delete: if isAdmin() && resource.data.organizationId == getRequesterOrgId();
    }

    // Audit logs - read for operators/admins within org, create only by system (via Cloud Functions)
    // Operators/admins CANNOT create audit logs directly
    match /auditLogs/{logId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow create: if false; // Only Cloud Functions / trusted backend can create
      allow update, delete: if false; // Immutable
    }

    // Custom categories - operators and admins within their org
    match /customCategories/{categoryId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow create: if isOperatorOrAdmin() && request.resource.data.organizationId == getRequesterOrgId();
      allow update: if isOperatorOrAdmin() && 
        resource.data.organizationId == getRequesterOrgId() &&
        request.resource.data.organizationId == getRequesterOrgId();
      allow delete: if isOperatorOrAdmin() && resource.data.organizationId == getRequesterOrgId();
    }

    // Settings - only admins within their org
    match /settings/{settingId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow write: if isAdmin() && resource.data.organizationId == getRequesterOrgId();
    }

    // Sync status - operators and admins within their org
    match /syncStatus/{statusId} {
      allow read: if isOperatorOrAdmin() && requesterBelongsToOrg(resource.data.organizationId);
      allow write: if isOperatorOrAdmin() && request.resource.data.organizationId == getRequesterOrgId();
    }

    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
